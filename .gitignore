# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments (Preserving Flask venv and ML venv-ml)
venv/
.venv/
venv-ml/
.venv-ml/
env/
ENV/
env.bak/
venv.bak/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Flask session / instance files
instance/
.webassets-cache

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDE / Code Editor folders
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment variables
.env
.env.local

# =============================================================================
# Phase 2 Machine Learning & Dataset Exclusions
# =============================================================================
# Large image datasets and archive files
dataset/
data/
PlantVillage/
PlantVillage-Dataset/
*.zip
*.tar
*.tar.gz
*.tgz

# Heavy deep learning model weights and serialized graphs
# (We preserve tracking metadata files: class_indices.json and model_metadata.json)
models/*.keras
models/*.h5
models/*.hdf5
models/*.tflite
models/*.pb
models/*.onnx
models/variables/
models/assets/
!models/.gitkeep
!models/class_indices.json
!models/model_metadata.json

# TensorBoard logs and training checkpoints
training/logs/
checkpoints/
*.log
